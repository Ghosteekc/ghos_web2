# Базовый URL backend API.
#
# Production (Vercel + Railway):
#   VITE_API_URL=https://YOUR-SERVICE.up.railway.app
# Без / в конце. После смены — обязательный Redeploy на Vercel (VITE_* вшивается в билд).
#
# Альтернатива: VITE_API_URL пустой, тогда /api/* идёт через vercel.json → rewrites → destination
# (сейчас там не должен оставаться loca.lt — только Railway HTTPS).
#
# Локальная разработка: пусто (Vite проксирует /api → localhost:8080) или:
#   VITE_API_URL=http://localhost:8080
VITE_API_URL=

# Необязательные ссылки на утверждённые владельцем документы Ghosteek Pro.
# Пустые значения не показываются в Mini App. Указывать только действующие HTTPS-адреса.
VITE_PRO_TERMS_URL=
VITE_PRO_REFUND_POLICY_URL=
